rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // بيانات المستخدمات: كل مستخدمة تقرأ بياناتها فقط
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false; // لا تعديل من التطبيق، فقط يدويًا من Firebase Console
    }

    // التقارير: أي شخص مسجل دخول فقط يقدر يقرأ/يكتب (يشمل الحفظ والإرسال والاعتماد)
    match /reports/{reportId} {
      allow read, write: if request.auth != null;
    }

    // بيانات المراكز: مديرة المركز تقرأ/تكتب بيانات مركزها فقط،
    // وإدارة التعليم فقط تقدر تشوف كل المراكز مجمّعة (الموظفات ممنوعات تمامًا)
    match /centerReports/{centerId} {
      allow read: if request.auth != null && (
        request.auth.uid == centerId ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'education_admin'
      );
      allow create, update: if request.auth != null && (
        request.auth.uid == centerId ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'education_admin'
      );
      allow delete: if false;
    }
  }
}
